# Copie para .env.aws-pilot e preencha antes do deploy AWS.
# Gerado automaticamente por aws-deploy-comercial-ec2.sh se não existir.

# Host público (sslip.io piloto ou domínio próprio)
DOMAIN=56-125-12-61.sslip.io

# URLs públicas (mesmo host: app + API + Keycloak em /auth)
APP_URL=https://56-125-12-61.sslip.io
KEYCLOAK_PUBLIC_URL=https://56-125-12-61.sslip.io/auth
KEYCLOAK_ISSUER_URL=https://56-125-12-61.sslip.io/auth/realms/comercialcloud

POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

COMERCIAL_CLOUD_KEYCLOAK_PROVISIONING_ENABLED=true

# Billing — sandbox até credenciais de produção
COMERCIAL_CLOUD_BILLING_GATEWAY=sandbox
COMERCIAL_CLOUD_BILLING_ASAAS_ENABLED=false
COMERCIAL_CLOUD_BILLING_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Produção: COMERCIAL_CLOUD_BILLING_GATEWAY=asaas
# Produção: COMERCIAL_CLOUD_BILLING_ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Fiscal — sandbox até homologação SEFAZ
COMERCIAL_CLOUD_FISCAL_PROVIDER=sandbox
COMERCIAL_CLOUD_FISCAL_FOCUSNFE_ENABLED=false
# Produção: COMERCIAL_CLOUD_FISCAL_PROVIDER=focusnfe
FOCUSNFE_TOKEN=

COMERCIAL_CLOUD_MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=noreply@example.com

# Amazon SES (opcional — após verificar domínio no console AWS)
# MAIL_HOST=email-smtp.sa-east-1.amazonaws.com
# MAIL_USER=
# MAIL_PASSWORD=

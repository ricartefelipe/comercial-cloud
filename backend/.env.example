# PostgreSQL
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/comercialcloud
QUARKUS_DATASOURCE_USERNAME=comercialcloud
QUARKUS_DATASOURCE_PASSWORD=comercialcloud

# HTTP
QUARKUS_HTTP_PORT=8080

# Perfil auth (Keycloak): quarkus dev -Dquarkus.profile=auth
# QUARKUS_OIDC_AUTH_SERVER_URL=http://localhost:8180/realms/comercialcloud
# QUARKUS_OIDC_CLIENT_ID=comercial-cloud-api

# Asaas (billing.gateway=asaas)
# COMERCIAL_CLOUD_BILLING_ASAAS_ENABLED=true
# ASAAS_API_KEY=sua_chave_sandbox_ou_producao
# ASAAS_WEBHOOK_TOKEN=token_opcional_webhook

# Focus NFe (fiscal.provider=focusnfe)
# COMERCIAL_CLOUD_FISCAL_FOCUSNFE_ENABLED=true
# FOCUSNFE_TOKEN=seu_token_focus

# Keycloak provisioning pós-onboarding
# COMERCIAL_CLOUD_KEYCLOAK_PROVISIONING_ENABLED=true

# E-mail transacional (SMTP)
# COMERCIAL_CLOUD_MAIL_ENABLED=true
# MAIL_FROM=noreply@seudominio.com.br
# MAIL_HOST=smtp.seudominio.com.br
# MAIL_PORT=587
# MAIL_STARTTLS=REQUIRED
# APP_URL=https://app.seudominio.com.br

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=comercialcloud
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=comercial-cloud-web
# Como o painel entra: keycloak (padrão, produção), demo (demonstração pública: a API exige a sessão da conta de
# demonstração, com COMERCIAL_CLOUD_TENANT_RESOLUTION=demo no backend) ou header (só desenvolvimento local, sem Keycloak).
NEXT_PUBLIC_AUTH_MODE=header
# Só no modo demo: conta pública exibida na tela de login (a senha é a COMERCIAL_CLOUD_DEMO_SENHA do backend).
# NEXT_PUBLIC_DEMO_EMAIL=admin@demo.com
# NEXT_PUBLIC_DEMO_SENHA=

# Termos e privacidade: rotas nativas /termos e /privacidade no frontend
